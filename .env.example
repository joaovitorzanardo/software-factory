# Signing secret do webhook (Linear → Settings → API → Webhooks)
LINEAR_WEBHOOK_SECRET=
HOST=0.0.0.0
PORT=8000

# Temporal
TEMPORAL_ADDRESS=localhost:7233
TASK_QUEUE=software-factory

# Worker: sandbox E2B + Claude Code
E2B_API_KEY=
# E2B_TEMPLATE=claude
# Auth do Claude Code no sandbox: defina exatamente UMA das duas.
# Chave da API (cobrança por token, console.anthropic.com)
ANTHROPIC_API_KEY=
# ou token da assinatura Claude (gerado com `claude setup-token`)
CLAUDE_CODE_OAUTH_TOKEN=
# GitHub App (ver README, seção "GitHub App"): id do App e caminho do arquivo .pem da private key.
# O token de instalação é gerado por issue, restrito ao repo dela, e vale 1h. O repo de cada issue
# vem do link nos Resources do projeto do Linear, e o comando de testes vem do `.factory.toml` do repo.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_PATH=
# Personal API key do Linear (Settings → Security & access → Personal API keys),
# com permissão de escrita em issues (move o status da issue)
LINEAR_API_KEY=

# Aviso por email quando a sessão do Claude (janela de 5h da assinatura) passa de 80%.
# Só funciona com CLAUDE_CODE_OAUTH_TOKEN; sem SMTP_HOST o aviso de uso fica desligado.
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587 (STARTTLS) e uma senha de app (exige 2FA).
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# Remetente (default: SMTP_USERNAME)
# ALERT_EMAIL_FROM=
# Destinatário do aviso
# ALERT_EMAIL_TO=
# Fuso do horário do reset no email
# ALERT_TIMEZONE=America/Sao_Paulo

# --- Docker Compose ---
# No compose, TEMPORAL_ADDRESS, GITHUB_APP_PRIVATE_KEY_PATH e TOKEN_USAGE_DB são sobrescritas.
# A private key do GitHub App é lida deste arquivo no host (default ./secrets/github-app.pem).
# GITHUB_APP_PRIVATE_KEY_FILE=./secrets/github-app.pem
# Descomente para subir junto o túnel cloudflared (URL pública do webhook nos logs do serviço tunnel).
# COMPOSE_PROFILES=tunnel
