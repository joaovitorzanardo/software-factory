# Signing secret do webhook (Linear → Settings → API → Webhooks)
LINEAR_WEBHOOK_SECRET=
HOST=0.0.0.0
PORT=8000

# Temporal
TEMPORAL_ADDRESS=localhost:7233
TASK_QUEUE=software-factory

# Worker: sandbox E2B + Claude Code
E2B_API_KEY=
# E2B_TEMPLATE=claude
# Auth do Claude Code no sandbox: defina exatamente UMA das duas.
# Chave da API (cobrança por token, console.anthropic.com)
ANTHROPIC_API_KEY=
# ou token da assinatura Claude (gerado com `claude setup-token`)
CLAUDE_CODE_OAUTH_TOKEN=
# Token fine-grained do GitHub com acesso aos repos dos projetos, Contents: Read and write e
# Pull requests: Read and write (push da branch e abertura da PR). O repo de cada issue vem do
# link nos Resources do projeto do Linear, e o comando de testes vem do `.factory.toml` do repo.
# Trate o token como exposto ao agente: o clone e o push rodam no mesmo sandbox em que o Claude
# tem Bash (o token fica fora do origin, mas isso não isola de verdade)
GITHUB_TOKEN=
# Personal API key do Linear (Settings → Security & access → Personal API keys),
# com permissão de escrita em issues (move o status da issue)
LINEAR_API_KEY=

# Aviso por email quando a sessão do Claude (janela de 5h da assinatura) passa de 80%.
# Só funciona com CLAUDE_CODE_OAUTH_TOKEN; sem SMTP_HOST o aviso de uso fica desligado.
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587 (STARTTLS) e uma senha de app (exige 2FA).
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# Remetente (default: SMTP_USERNAME)
# ALERT_EMAIL_FROM=
# Destinatário do aviso
# ALERT_EMAIL_TO=
# Fuso do horário do reset no email
# ALERT_TIMEZONE=America/Sao_Paulo
