# Signing secret do webhook (Linear → Settings → API → Webhooks)
LINEAR_WEBHOOK_SECRET=
HOST=0.0.0.0
PORT=8000

# Temporal
TEMPORAL_ADDRESS=localhost:7233
TASK_QUEUE=software-factory

# Worker: sandbox E2B + Claude Code
E2B_API_KEY=
# E2B_TEMPLATE=claude
# Auth do Claude Code no sandbox: defina exatamente UMA das duas.
# Chave da API (cobrança por token, console.anthropic.com)
ANTHROPIC_API_KEY=
# ou token da assinatura Claude (gerado com `claude setup-token`)
CLAUDE_CODE_OAUTH_TOKEN=
# Token fine-grained do GitHub restrito ao repo alvo, Contents: Read and write e
# Pull requests: Read and write (push da branch e abertura da PR). Trate-o como exposto ao
# agente: o do plano pode ler .git/config; o da implementação roda com Bash no mesmo sandbox
# em que o push é feito depois (o token sai do origin, mas isso não isola de verdade)
GITHUB_TOKEN=
# Repo que a fábrica opera, formato owner/repo
TARGET_REPO=
# Comando que roda os testes do repo alvo no sandbox (exit 0 = verde); a PR só abre com verde
TEST_COMMAND=
# Personal API key do Linear (Settings → Security & access → Personal API keys),
# com permissão de escrita em issues (move o status da issue)
LINEAR_API_KEY=
